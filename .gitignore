node_modules/
dist/
dist_electron/
release/
.DS_Store
*.log

# Downloaded GM guitar soundfont packs (~50 MB total). Fetched by
# Download-Soundfonts.ps1 or automatically by Build-Installer.ps1. Not
# checked in because they bloat the repo and can be re-downloaded on
# demand. The public/soundfonts/README.txt file IS committed (see the
# negation below) so the folder always exists.
public/soundfonts/*
!public/soundfonts/README.txt

# Guitar sample libraries (multi-sample .exs/.gig + WAV) - pot fi de la
# sute de MB pana la cativa GB. NU intra in git. Userul le tine LOCAL in
# public/guitar samples/ (copiate in EXE la build de Build-Installer.ps1).
# Se comiteaza DOAR README.md. Fiecare librarie poate avea un descriptor
# `library.json` (optional) - si ala ramane local, langa librarie.
public/guitar samples/*
!public/guitar samples/README.md

# Build output folders
portable-out/
installer-out/
.desktop-build/
Ample Guitar Chord Progression Helper/

# Fisiere intermediare generate de scripturile PSD (self-contained HTMLs
# le au deja embedded ca base64, deci PNG-urile nu sunt necesare in git).
docs/graphics/generated/

# Raport generat de inspect-guitar-library.mjs (temporar, nu se comiteaza)
scripts/library-report.txt
__pycache__/

# iesirile generate de scripts/genereaza-acorduri.py
diagrame/
diag_prog/
