{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:electron": "cross-env BUILD_TARGET=electron vite build",
    "preview": "vite preview --host 0.0.0.0",
    "psd:delete": "node scripts/psd-to-svg.mjs docs/graphics/psd/buton-delete.psd delete",
    "psd:play": "node scripts/psd-to-svg.mjs docs/graphics/psd/buton-play.psd play",
    "psd:pause": "node scripts/psd-to-svg.mjs docs/graphics/psd/buton-pause.psd pause",
    "psd:stop": "node scripts/psd-to-svg.mjs docs/graphics/psd/buton-stop.psd stop",
    "psd:drag": "node scripts/psd-to-svg.mjs docs/graphics/psd/buton-drag.psd drag",
    "psd:all": "npm run psd:delete && npm run psd:play && npm run psd:pause && npm run psd:stop && npm run psd:drag"
  },
  "dependencies": {
    "@electron/packager": "^18.4.4",
    "@fontsource/bebas-neue": "^5.3.0",
    "clsx": "2.1.1",
    "electron": "^30.5.1",
    "electron-builder": "^26.15.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "soundfont-player": "^0.12.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "ag-psd": "^31.0.2",
    "cross-env": "^7.0.3",
    "sharp": "^0.35.3",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
